{
  "name": "gems-lms-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:all && ng s",
    "build": "ng build main",
    "watch": "ng build --watch --configuration development",
    "build:all": "ng build shared && ng build auth && ng build education && ng build instructor && ng build admin",
    "test": "ng test",
    "test:ci": "ng test shared --watch=false --browsers=ChromeHeadless && ng test auth --watch=false --browsers=ChromeHeadless && ng test education --watch=false --browsers=ChromeHeadless && ng test admin --watch=false --browsers=ChromeHeadless && ng test instructor --watch=false --browsers=ChromeHeadless && ng test main --watch=false --browsers=ChromeHeadless",
    "test:e2e": "npm run build:all && playwright test",
    "storybook": "ng run main:storybook",
    "build:storybook": "ng run main:build-storybook",
    "serve:ssr:main": "node dist/main/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "@angular/ssr": "22.2.1",
    "driver.js": "^1.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "github-markdown-css": "^5.9.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.47",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.13",
    "ngx-markdown": "22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.1",
    "@angular/animations": "22.2.1",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular": "10.6.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "baseline-browser-mapping": "^2.10.31",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "22.2.4",
    "storybook": "10.6.1",
    "typescript": "~6.0.3"
  }
}
