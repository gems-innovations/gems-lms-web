{
  "id": "estudio",
  "name": "Estudio GEMS",
  "version": 1,

  "canvas": "2d",
  "renderer": "renderer2d.js",
  "light": "light.js",
  "css": "theme.css",
  "defaultWorld": "laboratorio",

  "font": { "family": "Rubik", "src": "../../../fonts/rubik-latin-700-normal.woff2" },
  "palette": {
    "accent": "#4DE1FF",
    "good": "#34D399",
    "bad": "#F87171",
    "planet": "#9B8FF8",
    "confetti": ["#7B6FF0", "#4DE1FF", "#C471ED", "#FFD166", "#34D399"],
    "hit": ["#F87171", "#FFD166", "#FFFFFF"],
    "poof": ["#E9E6FF", "#C9C3F5", "#9B8FF8"]
  },
  "particles": { "shape": "mixed" },

  "characters": {
    "chispa": { "name": "Chispa", "look": { "body": "#7B6FF0", "bodyDark": "#5B4EC1", "belly": "#9B8FF8", "glow": "#4DE1FF", "antenna": "#C471ED", "antennaStyle": "ball" } },
    "nube":   { "name": "Nube",   "look": { "body": "#C471ED", "bodyDark": "#9A4FC4", "belly": "#DDA5F5", "shell": "#F4FBFF", "shellShade": "#CDEBF5", "screen": "#10243A", "glow": "#7CFFCB", "antenna": "#FFD166", "antennaStyle": "double" } }
  },

  "scenes": {
    "laboratorio": { "sky": ["#1E1B4B", "#3B2F86"], "ground": "#2A2566", "groundDark": "#2A2566" },
    "espacio":     { "sky": ["#080710", "#1E1B4B"], "ground": "#3A3566", "groundDark": "#3A3566" },
    "aula":        { "sky": ["#1B2B4F", "#2B3F73"], "sun": false, "ground": "#2B2458", "groundDark": "#2B2458" },
    "biblioteca":  { "sky": ["#3A1F2B", "#5A2E3A"], "sun": false, "ground": "#4A2A1E", "groundDark": "#3A2016" },
    "observatorio": { "sky": ["#0B1630", "#16264D"], "ground": "#2A3350", "groundDark": "#20283F" },
    "jardin":      { "sky": ["#2E7D6B", "#5FB39A"], "ground": "#2F5D3A", "groundDark": "#24492D" },
    "cocina":      { "sky": ["#C2563A", "#E08A5C"], "sun": false, "ground": "#4B3A5C", "groundDark": "#3B2D49" },
    "museo":       { "sky": ["#1F3B4D", "#2E5670"], "sun": false, "ground": "#3D3326", "groundDark": "#2F271D" }
  },

  "shots": {
    "centro":          { "x": 0 },
    "izquierda":       { "x": -0.24, "zoom": 0.9 },
    "derecha":         { "x": 0.24, "zoom": 0.9, "flip": true },
    "cerca-izquierda": { "x": -0.17, "zoom": 1.08 },
    "cerca-derecha":   { "x": 0.17, "zoom": 1.08, "flip": true },
    "lejos":           { "x": 0.12, "zoom": 0.74 }
  },
  "enters": ["vuela", "cae", "aparece", "saluda"],
  "props": { "reloj": {}, "planta": {}, "globo": {}, "libros": {}, "telescopio": {}, "cohete": {}, "microscopio": {}, "mapa": {} },
  "visuals": {
    "module": "visuals.js",
    "objects": { "balanza": ["compara"], "calendario": ["febrero", "atras", "manana"], "palabra": ["contar", "ultima", "medio"], "planetas": ["cercano", "grande", "ocho"] }
  },
  "escenas": {
    "module": "visuals.js",
    "objects": ["esqueleto", "pulpo", "vaso-hielo", "tormenta", "olla-altura", "sol-tierra", "gaseosa"]
  },

  "cine": {
    "planos": {
      "general":      { "s": 1, "host": 0.72, "ligero": { "s": 0.78 } },
      "cenital":      { "s": 1.04, "floor": 0.66, "host": 0.76, "ligero": { "s": 0.76, "suelo": 66 } },
      "picado":       { "s": 1.02, "floor": 0.84, "host": 0.88, "ligero": { "s": 0.88, "suelo": 58 } },
      "contrapicado": { "s": 1.04, "floor": 1.2, "host": 1.18, "ligero": { "s": 1.16, "suelo": 40 } },
      "primer-plano": { "s": 1.55, "host": 1, "ligero": { "s": 1.38 } },
      "travelling":   { "s": 1.16, "pan": 0.06, "ligero": { "s": 1.04 } },
      "orbita":       { "s": 1.1, "breathe": 0.05, "ligero": { "s": 0.96 } },
      "diagonal":     { "s": 1.12, "rot": -0.06, "ligero": { "s": 1.08 } }
    },
    "horas": {
      "dia": {},
      "tarde": { "sky": ["#5B2A4E", "#C2563A"] },
      "amanecer": { "sky": ["#3D3A7A", "#E89AB0"] },
      "noche": { "sky": ["#0B0A24", "#1E1B4B"] }
    },
    "horasMundos": ["laboratorio", "aula", "biblioteca", "observatorio", "jardin", "cocina", "museo"],
    "climas": {
      "polvo": ["aula", "biblioteca", "museo"],
      "burbujas": ["laboratorio", "cocina"],
      "chispas": ["laboratorio", "espacio", "observatorio"],
      "hojas": ["jardin"],
      "lluvia": ["jardin"],
      "notas": ["aula", "museo", "cocina"]
    },
    "fauna": {
      "pajaros": ["jardin", "observatorio"],
      "gato": ["aula", "biblioteca", "cocina", "museo"],
      "dron": ["laboratorio", "espacio", "aula", "observatorio"],
      "peces": ["laboratorio", "cocina", "jardin", "biblioteca"],
      "mariposas": ["jardin"]
    },
    "transiciones": ["corte", "barrido", "zoom", "fundido"]
  },

  "sounds": {
    "pop":    { "tones": [["sine", 420, 840, 0.09, 0.12]] },
    "ding":   { "tones": [["sine", 1046, 1046, 0.22, 0.14], ["sine", 1568, 1568, 0.2, 0.1, 0.07], ["triangle", 2093, 2093, 0.12, 0.04, 0.07]] },
    "bonk":   { "tones": [["triangle", 330, 140, 0.18, 0.16], ["sine", 160, 80, 0.24, 0.12, 0.02]] },
    "result": { "tones": [["sine", 523, 523, 0.18, 0.13], ["sine", 659, 659, 0.18, 0.13, 0.1], ["sine", 784, 784, 0.18, 0.13, 0.2], ["sine", 1046, 1046, 0.35, 0.14, 0.3], ["triangle", 1568, 1568, 0.3, 0.05, 0.3]] },
    "aww":    { "tones": [["sine", 440, 330, 0.3, 0.12], ["sine", 330, 247, 0.4, 0.12, 0.25]] },
    "blip":   { "tones": [["sine", 900, 900, 0.035, 0.035]] },
    "whoosh": { "noise": [0.25, 0.18, 500, 2400] }
  },

  "reactions": {
    "idle":      { "anim": "idle", "reducedAnim": "still" },
    "think":     { "anim": "think", "reducedAnim": "think" },
    "ask":       { "anim": "talk", "reducedAnim": "still", "sfx": ["pop"], "duration": 1.5, "then": "think", "say": [] },
    "celebrate": { "anim": "celebrate", "reducedAnim": "happy", "fx": ["ring", "flash"], "sfx": ["ding"], "particles": "confetti", "duration": 2.0, "then": "idle", "tone": "celebrate",
                   "say": ["¡Eureka!", "¡Exacto!", "¡Brillante!", "¡Lo sabías!", "¡Así se piensa!"] },
    "hurt":      { "anim": "hurt", "reducedAnim": "oops", "fx": ["shake"], "sfx": ["bonk"], "particles": "hit", "duration": 1.6, "then": "think", "tone": "hurt",
                   "say": ["¡Ups!", "Casi…", "Error de cálculo", "Mmm, no", "¡Era trampa!"] },
    "win":       { "anim": "dance", "reducedAnim": "happy", "fx": ["ring"], "sfx": ["result"], "particles": "confetti", "tone": "celebrate", "say": [] },
    "lose":      { "anim": "sad", "reducedAnim": "oops", "sfx": ["aww"], "tone": "hurt", "say": [] }
  }
}
