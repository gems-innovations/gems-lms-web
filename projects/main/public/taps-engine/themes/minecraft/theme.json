{
  "id": "minecraft",
  "name": "Minecraft",
  "version": 1,

  "renderer": "renderer3d.js",
  "light": "light.js",
  "vendor": { "skinview3d": "vendor/skinview3d.bundle.js" },
  "defaultWorld": "pradera",

  "font": { "family": "Pixelify Sans", "src": "fonts/pixelify-sans.woff2" },
  "palette": {
    "accent": "#c6f66a",
    "good": "#2f8f2f",
    "bad": "#c2332a",
    "confetti": ["#c6f66a", "#ffd84a", "#6ad7ff", "#ff8ad0"],
    "hit": ["#ffffff", "#fff3a0", "#ffd84a"],
    "poof": ["#e8e8e8", "#bdbdbd", "#9a9a9a"]
  },

  "characters": {
    "leo":   { "name": "Leo",   "skin": "skins/leo.png" },
    "sofi":  { "name": "Sofi",  "skin": "skins/sofi.png", "slim": true },
    "mateo": { "name": "Mateo", "skin": "skins/mateo.png" },
    "dani":  { "name": "Dani",  "skin": "skins/dani.png" }
  },

  "camera": {
    "dist": 105, "height": 8, "lookY": -5, "sway": 0.1, "swaySpeed": 0.5,
    "worlds": { "cueva": { "dist": 100, "height": 6 }, "nether": { "dist": 100 } }
  },

  "shots": {
    "centro":          { "x": 0 },
    "izquierda":       { "x": -0.2, "zoom": 0.92, "yaw": 0.32 },
    "derecha":         { "x": 0.2, "zoom": 0.92, "yaw": -0.32 },
    "cerca-izquierda": { "x": -0.12, "zoom": 1.12, "yaw": 0.18, "height": -4 },
    "cerca-derecha":   { "x": 0.12, "zoom": 1.12, "yaw": -0.18, "height": -4 },
    "lejos":           { "x": 0.1, "zoom": 0.74, "yaw": -0.12, "height": 6 }
  },
  "enters": ["camina", "salta", "gira", "saluda"],
  "props": { "taller": {}, "biblioteca": {}, "circuito": {}, "corral": {}, "portal": {}, "campamento": {}, "mina": {},
             "granja": {}, "iglu": {}, "cristales": {}, "ruinas": {}, "muelle": {} },
  "visuals": {
    "module": "visuals.js",
    "objects": {
      "receta": ["crafteo"], "piston": ["bloquea"], "reloj": ["dia", "cama"], "comparador": ["cofre"]
    }
  },
  "escenas": {
    "module": "visuals.js",
    "objects": ["creeper", "enderman", "lobo", "golem-nieve", "piston", "ghast", "vaca-champinon", "arco"]
  },

  "cine": {
    "planos": {
      "general":      { "el": 14, "zoom": 0.62, "ty": -2, "oy": 0.06, "ligero": { "s": 0.74, "suelo": 40 } },
      "cenital":      { "el": 52, "zoom": 0.52, "ty": -10, "oy": 0.03, "ligero": { "s": 0.72, "suelo": 62 } },
      "picado":       { "el": 32, "zoom": 0.95, "ty": -8, "oy": 0.08, "ligero": { "s": 0.86, "suelo": 54 } },
      "contrapicado": { "el": -7, "zoom": 1.05, "ty": 7, "oy": 0.1, "ligero": { "s": 1.2, "suelo": 34 } },
      "primer-plano": { "el": 4, "zoom": 1.8, "ty": 9, "oy": 0.08, "ligero": { "s": 1.42, "suelo": 38 } },
      "travelling":   { "el": 8, "zoom": 1.08, "ty": -4, "oy": 0.04, "travel": 0.2, "ligero": { "s": 1.04 } },
      "orbita":       { "el": 13, "zoom": 0.95, "ty": -4, "oy": 0.05, "orbit": 0.75, "ligero": { "s": 0.94 } },
      "diagonal":     { "el": 9, "az": 0.55, "zoom": 1, "ty": -2, "oy": 0.05, "roll": 0.12, "ligero": { "s": 1.1 } }
    },
    "horas": {
      "dia": {},
      "tarde": { "sky": ["#2c3e8f", "#ffb36b"] },
      "amanecer": { "sky": ["#4a6fc0", "#ffe1b0"] },
      "noche": { "sky": ["#03061a", "#1c2a5a"] }
    },
    "horasMundos": ["pradera", "bosque", "aldea", "desierto", "nieve", "playa"],
    "climas": {
      "lluvia": ["pradera", "bosque", "aldea", "playa", "noche"],
      "polen": ["pradera", "aldea"],
      "hojas": ["bosque", "pradera"],
      "arena": ["desierto"],
      "luciernagas": ["bosque", "noche"],
      "goteo": ["cueva"],
      "polvo": ["casa", "cueva"],
      "ceniza": ["nether"]
    },
    "fauna": {
      "ovejas": ["pradera", "aldea", "bosque"],
      "vacas": ["pradera", "aldea"],
      "gallinas": ["aldea", "pradera"],
      "lobos": ["bosque", "nieve"],
      "zorros": ["bosque", "nieve"],
      "conejos": ["desierto", "nieve"],
      "tortugas": ["playa"],
      "murcielagos": ["cueva", "noche"],
      "ghasts": ["nether"],
      "endermans": ["end"],
      "gatos": ["casa"]
    },
    "transiciones": ["corte", "barrido", "zoom", "fundido"]
  },

  "scenes": {
    "pradera":   { "sky": ["#3f8fe0", "#cfeaff"], "ground": "#5da83a", "groundDark": "#865a36" },
    "bosque":    { "sky": ["#4d97d6", "#cfe6d8"], "ground": "#4f9a35", "groundDark": "#7a5330" },
    "noche":     { "sky": ["#03061a", "#1c2a5a"], "sun": false, "ground": "#2f6a2a", "groundDark": "#4a331f" },
    "cueva":     { "sky": ["#0b0a09", "#25201b"], "sun": false, "ground": "#6b6b6b", "groundDark": "#4e4e4e" },
    "nether":    { "sky": ["#1a0303", "#7a2410"], "sun": false, "ground": "#8a2f2f", "groundDark": "#5e2020" },
    "end":       { "sky": ["#05020b", "#241338"], "sun": false, "ground": "#e2e2a8", "groundDark": "#b9b985" },
    "nieve":     { "sky": ["#8fb0d6", "#e7f0fa"], "ground": "#f4f9ff", "groundDark": "#865a36" },
    "desierto":  { "sky": ["#5ea8e8", "#f3e2b8"], "ground": "#e3d39b", "groundDark": "#c9b27a" },
    "aldea":     { "sky": ["#3f8fe0", "#cfeaff"], "ground": "#5da83a", "groundDark": "#96754a" },
    "casa":      { "sky": ["#6b4a2b", "#a0784a"], "sun": false, "ground": "#b08a5a", "groundDark": "#7a5a36" },
    "playa":     { "sky": ["#ff9b63", "#ffe0b0"], "ground": "#e8d79e", "groundDark": "#cdb67c" }
  },

  "sounds": {
    "damage": { "files": ["sounds/player_damage.ogg"], "vol": 0.8, "synth": "wrong" },
    "hit":    { "files": ["sounds/default_dug_node.1.ogg", "sounds/default_dug_node.2.ogg"], "vol": 0.8, "synth": "crit" },
    "pop":    { "files": ["sounds/default_place_node.1.ogg", "sounds/default_place_node.2.ogg"], "vol": 0.7, "synth": "pop" },
    "boom":   { "files": ["sounds/tnt_explode.ogg"], "vol": 0.7, "synth": "wrong" }
  },

  "reactions": {
    "idle":      { "anim": "idle" },
    "think":     { "anim": "think" },
    "ask":       { "anim": "talk", "reducedAnim": "idle", "sfx": ["pop"], "duration": 1.5, "then": "think", "say": [] },
    "celebrate": { "anim": "celebrate", "reducedAnim": "idle", "fx": ["push"], "sfx": ["jingle"], "particles": "confetti", "duration": 2.2, "then": "idle", "tone": "celebrate",
                   "say": ["¡Eso!", "¡Crack!", "¡Bien jugado!", "¡Exacto!", "¡Cómo lo sabías!"] },
    "hurt":      { "anim": "hurt", "reducedAnim": "idle", "fx": ["hurt"], "sfx": ["damage", "hit"], "particles": "hit", "duration": 1.5, "then": "think", "tone": "hurt",
                   "say": ["¡Auch!", "Casi…", "Ouch…", "Esa dolió", "Nooo…"] },
    "win":       { "anim": "dance", "reducedAnim": "idle", "fx": ["push"], "sfx": ["result"], "particles": "confetti", "tone": "celebrate", "say": [] },
    "lose":      { "anim": "sad", "reducedAnim": "idle", "sfx": ["wrong"], "tone": "hurt", "say": [] }
  }
}
